RADAR_PORT=8080

# claude hoặc codex
RADAR_AI_PROFILE=claude

# Key riêng của dự án OpenAI nếu dùng cấu hình codex.
OPENAI_API_KEY=

# Key YouTube Data API v3 để đồng bộ video công khai.
YOUTUBE_API_KEY=

# Đường dẫn đến Chrome và hồ sơ riêng dùng để lưu gói dịch trên máy.
RADAR_NEWS_CHROME=
RADAR_NEWS_CHROME_PROFILE=

# Để trống để dùng model mặc định của profile.
RADAR_CODEX_CRAWL_MODEL=
RADAR_CODEX_ANALYSIS_MODEL=
RADAR_CLAUDE_CRAWL_MODEL=
RADAR_CLAUDE_ANALYSIS_MODEL=
